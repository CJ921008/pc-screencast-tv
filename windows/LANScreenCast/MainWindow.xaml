<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LANScreenCast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="LayoutRoot" RequestedTheme="Dark" Background="#101614">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#9CEBBD" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B3F3CC" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#80CAA0" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#102318" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#102318" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#B3C5BB" />
            <SolidColorBrush x:Key="MintBrush" Color="#9CEBBD" />
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="#18211E" />
                <Setter Property="BorderBrush" Value="#35443D" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="22" />
            </Style>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="20" MaxWidth="1120">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AppVersion" Foreground="{StaticResource MintBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="桌面投屏" FontSize="36" FontWeight="SemiBold" />
                    <TextBlock Text="将 Windows 画面和声音投到手机或电视" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Grid x:Name="Body" ColumnSpacing="16" RowSpacing="16" SizeChanged="Body_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SettingsPanel" Style="{StaticResource Panel}" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <TextBlock Text="连接设置" FontSize="21" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="LanTab" Content="局域网投屏" IsChecked="True"
                                              HorizontalAlignment="Stretch" MinHeight="42" Click="Lan_Click" />
                                <ToggleButton x:Name="RemoteTab" Content="公网 IPv6" Grid.Column="1"
                                              HorizontalAlignment="Stretch" MinHeight="42" Click="Remote_Click" />
                            </Grid>

                            <StackPanel x:Name="LanSettings" Spacing="12">
                                <TextBox x:Name="ReceiverIp" Header="接收设备 IPv4" PlaceholderText="输入手机或电视上显示的 IP" />
                                <ComboBox x:Name="TransportMode" Header="投屏格式" SelectedIndex="0"
                                          HorizontalAlignment="Stretch" SelectionChanged="Transport_Changed">
                                    <ComboBoxItem Content="H.264 · 画面与声音" />
                                    <ComboBoxItem Content="JPEG · 兼容模式" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="RemoteSettings" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="本机公网 IPv6" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RemoteIp" PlaceholderText="例如 240e:…" FontFamily="Consolas"
                                             AutomationProperties.Name="本机公网 IPv6" TextChanged="RemoteIp_Changed" />
                                    <Button x:Name="DetectButton" Content="获取 IPv6" Grid.Column="1"
                                            VerticalAlignment="Stretch" Click="Detect_Click" />
                                </Grid>
                                <InfoBar x:Name="Ipv6Tip" IsClosable="False" IsOpen="False" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="Resolution" Header="分辨率" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="720p" />
                                    <ComboBoxItem Content="1080p" />
                                </ComboBox>
                                <ComboBox x:Name="FrameRate" Grid.Column="1" Header="目标帧率"
                                          SelectedIndex="3" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="10 FPS" />
                                    <ComboBoxItem Content="15 FPS" />
                                    <ComboBoxItem Content="20 FPS" />
                                    <ComboBoxItem Content="30 FPS" />
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="AllowRemoteInput">
                                <TextBlock Text="允许手机控制键盘和鼠标" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatusPanel" Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <TextBlock Text="会话状态" FontSize="21" FontWeight="SemiBold" />
                            <Border Background="#21382D" BorderBrush="#40584B" BorderThickness="1" CornerRadius="12" Height="92">
                                <FontIcon Glyph="&#xE7F4;" Foreground="{StaticResource MintBrush}" FontSize="32" />
                            </Border>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="StatusText" Text="等待连接" FontSize="17" FontWeight="SemiBold"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="StatusHint" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Grid>
                                <Button x:Name="StartButton" Content="开始投屏" MinHeight="44" HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                                <Button x:Name="StopButton" Content="停止投屏" MinHeight="44" HorizontalAlignment="Stretch"
                                        Click="Stop_Click" Visibility="Collapsed" />
                            </Grid>
                            <Button x:Name="RevokeInputButton" Content="撤销键鼠控制" HorizontalAlignment="Stretch"
                                    Click="RevokeInput_Click" Visibility="Collapsed" />
                            <StackPanel x:Name="PairingPanel" Spacing="8" Visibility="Collapsed">
                                <Button x:Name="CopyPairingButton" Content="复制配对码" HorizontalAlignment="Stretch"
                                        Click="CopyPairing_Click" IsEnabled="False" />
                                <CheckBox x:Name="ResetPairing">
                                    <TextBlock Text="下次启动远程接入时重置配对" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
