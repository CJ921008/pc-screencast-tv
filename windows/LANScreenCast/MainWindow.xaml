<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LANScreenCast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="440">
            <TextBlock Text="LAN ScreenCast" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Windows 桌面投屏" FontSize="22" />
            <TextBlock Text="在接收设备上打开 LAN 投屏接收器，输入画面显示的 IP 地址。电脑与接收设备须处于同一局域网。" TextWrapping="Wrap" />
            <TextBox x:Name="ReceiverIp" Header="接收设备 IP 地址" PlaceholderText="例如 192.168.1.25" />
            <ComboBox x:Name="FrameRate" Header="目标帧率" SelectedIndex="2">
                <ComboBoxItem Content="10 FPS" />
                <ComboBoxItem Content="15 FPS" />
                <ComboBoxItem Content="20 FPS" />
                <ComboBoxItem Content="30 FPS" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="StartButton" Content="开始投屏" Click="Start_Click" />
                <Button x:Name="StopButton" Content="停止投屏" Click="Stop_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="等待连接" TextWrapping="Wrap" />
            <TextBlock Text="当前版本传输桌面画面，暂不传输系统声音。" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
