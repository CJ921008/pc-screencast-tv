{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanscreencast.local/protocol/signaling.schema.json",
  "title": "LAN ScreenCast signaling envelope v1",
  "type": "object",
  "required": ["type", "requestId", "timestamp", "payload"],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "integer", "minimum": 0, "description": "Unix time in milliseconds" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
